# ==============================================================================
# Digital Field Drug Evidence System - Environment Configuration Template
# ==============================================================================
# COPY THIS FILE TO .env AND POPULATE WITH SECURE, PRODUCTION-GRADE SECRETS.
# NEVER COMMIT THE ACTUAL .env FILE OR CRYPTOGRAPHIC KEYS TO SOURCE CONTROL.

# Application Environment (development | staging | production)
ENVIRONMENT=production

# Application Metadata
PROJECT_NAME="Digital Field Drug Evidence System"
VERSION="1.0.0"

# Cryptographic Keys (MUST be rotated and generated with high entropy)
# Generate via: openssl rand -hex 32
SECRET_KEY=generate_a_random_32_byte_hex_string_for_jwt_auth
HMAC_SECRET=generate_a_random_32_byte_hex_string_for_hmac_signatures
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Primary Relational Database
# SQLite (default for isolated standalone field kits):
# DATABASE_URL=sqlite:///./storage/evidence.db
# PostgreSQL (recommended for production central forensic repositories):
DATABASE_URL=postgresql://forensic_app:replace_with_strong_db_password@postgres:5432/forensic_evidence_db

# Local / Object Storage Directory
STORAGE_DIR=./storage

# Upload Hardening & DoS Mitigations
# Maximum binary upload size in bytes (15 MB default)
MAX_UPLOAD_SIZE_BYTES=15728640
# Maximum image dimension width or height in pixels (decompression bomb protection)
MAX_IMAGE_DIMENSION=8192

# Rate Limiting (Requests per IP per minute)
RATE_LIMIT_PER_MINUTE=120

# CORS Allowed Origins (Comma-separated list of fully-qualified origins)
CORS_ORIGINS=https://evidence.forensics.gov,https://officer.forensics.gov

# Optical Quality Thresholds
MIN_LAPLACIAN_VAR=100.0
MIN_EXPOSURE_VAL=30.0
MAX_EXPOSURE_VAL=240.0
